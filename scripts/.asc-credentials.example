# App Store Connect API — kopiera till scripts/.asc-credentials och fyll i.
#
# Båda värdena är identifierare, inte hemligheter. Hemligheten är .p8-filen,
# som ska ligga i ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8 och
# aldrig i repot.
#
# Hittas i App Store Connect → Användare och åtkomst → Integrationer →
# App Store Connect API. Issuer ID står ovanför nyckellistan.

ASC_KEY_ID="XXXXXXXXXX"
ASC_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
